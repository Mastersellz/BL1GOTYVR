# Source-level regression guards, not a replacement for engine/headset tests.
file(READ "${SOURCE_DIR}/src/camera/CameraHook.cpp" camera)
string(FIND "${camera}" "static void __fastcall HookedViewportDraw(" viewport)
if(viewport LESS 0)
    message(FATAL_ERROR "Viewport preparation entry point missing")
endif()
string(SUBSTRING "${camera}" ${viewport} -1 viewport_code)
string(FIND "${viewport_code}" "SetRenderContext(" publish)
string(FIND "${viewport_code}" "ApplyRightHand(eye)" weapon)
if(publish LESS 0 OR weapon LESS publish)
    message(FATAL_ERROR "Current-pair arm context must be published before weapon/Draw")
endif()
string(SUBSTRING "${viewport_code}" ${weapon} -1 draw_tail)
string(FIND "${draw_tail}" "ReapplyRenderPalette()" palette)
string(FIND "${draw_tail}" "ReapplyWeaponPose()" stamp)
string(FIND "${draw_tail}" "s_originalViewportDraw(viewportClient, viewport, canvas)" draw)
if(palette LESS 0 OR stamp LESS palette OR draw LESS stamp)
    message(FATAL_ERROR "Prepare hands, then stamp weapon, before native Draw")
endif()
string(FIND "${draw_tail}" "SetRenderContext(" late_publish)
if(NOT late_publish EQUAL -1)
    message(FATAL_ERROR "Do not publish arm targets after the pair has been drawn")
endif()

file(READ "${SOURCE_DIR}/src/input/InputHook.cpp" input)
string(FIND "${input}" "m_renderWeaponStampActive = !m_weaponAttachmentDriven;" selected_owner)
string(FIND "${input}" "if (!m_weaponAttachmentDriven)" fallback_stamp)
string(FIND "${input}" "UseNativeIkAttachment(m_weaponAttachmentDriven," validated_attachment)
if(selected_owner LESS 0 OR fallback_stamp LESS 0 OR validated_attachment LESS 0)
    message(FATAL_ERROR "Use one weapon-placement owner: original native IK attachment or canonical fallback")
endif()

file(READ "${SOURCE_DIR}/src/player/ArmIKSystem.cpp" arms)
string(FIND "${arms}" "system.CaptureNativePoseAndRightHand(component)" native)
string(FIND "${arms}" "system.ApplyPostAnimation(component)" solve)
string(FIND "${arms}" "camera::PrepareMotionPairPostAnimation()" early_prepare)
string(FIND "${arms}" "memcpy(originalMatrices.data(), rig.nativePose" native_input)
string(FIND "${arms}" "inputHook.GetDrivenWeaponFrame(" stale_grip)
if(native LESS 0 OR solve LESS native OR native_input LESS 0 OR NOT stale_grip EQUAL -1)
    message(FATAL_ERROR "Solve from native animation and use this pair's off-hand weapon frame")
endif()
if(early_prepare LESS native OR solve LESS early_prepare)
    message(FATAL_ERROR "Prepare the current pair between native capture and post-animation IK")
endif()
file(READ "${SOURCE_DIR}/src/xr/FrameLoop.cpp" frames)
string(FIND "${frames}" "NeedsNewStereoPair(m_nextRenderEye, m_activePair.valid)" reuse)
string(FIND "${camera}" "eye == 0 && !renderTicket.motionPosePrepared" reuse_targets)
string(FIND "${camera}" "if (s_insideViewportDraw ||" avoid_late_preparation)
if(reuse LESS 0 OR reuse_targets LESS 0 OR avoid_late_preparation LESS 0)
    message(FATAL_ERROR "Draw must reuse early motion preparation, not replace or reenter it")
endif()
message(STATUS "Pose pipeline source guards passed")

string(FIND "${camera}" "recoverFirstPerson || frozenStereoAnchor" frozen_anchor)
string(FIND "${camera}" "negativeOrigin[axis] = anchorAdjustment.negativeOrigin[axis]" coherent_translation)
if(frozen_anchor LESS 0 OR coherent_translation LESS 0)
    message(FATAL_ERROR "Real stereo views must share the hand anchor and coherent shader pretranslation")
endif()

string(FIND "${input}" "camera::SuppressRecoilTick(" input_recoil_write)
string(FIND "${camera}" "if (!IsViewportPoseThread(GetCurrentThreadId()," owner_guard)
string(FIND "${camera}" "s_recoilAnchorRotation" stale_recoil_anchor)
string(FIND "${camera}" "SelectGamePitchReference(onFootPitch, originalRotation[0])" safe_pitch)
string(FIND "${camera}" "const float* baseTranslatedView = frozenViewRotation" frozen_rotation)
if(NOT input_recoil_write EQUAL -1 OR owner_guard LESS 0 OR
   NOT stale_recoil_anchor EQUAL -1 OR safe_pitch LESS 0 OR frozen_rotation LESS 0)
    message(FATAL_ERROR "Camera recoil needs a viewport owner, trusted pitch and frozen stereo rotation")
endif()
